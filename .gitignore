# ===========================================
# Space Debris Tracker - .gitignore
# ===========================================

# Backup files (HTML snapshots)
backup-*.html
backup-*/
backup_v*/
backups/
*.backup_*
index_v*_backup.html
index.html.backup_*
backup_v*.html

# Large data files (kept in data/ or webapp/ only)
/orbital_data_full.json
/orbital_data.json
/ml_predictions.json
/raw_tle.txt
/satcat_catalog.json
/satellite_positions.json
/embedded_data.json

# Duplicate notebooks
(Clone)*.ipynb
*-1.ipynb

# Python
__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/

# Databricks
.databricks/
*.dbfs

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Node (if ever needed)
node_modules/
package-lock.json

# Logs
*.log
npm-debug.log*