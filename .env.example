# Space Debris Tracker - Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_APP=webapp/app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Server Configuration
PORT=8000
HOST=0.0.0.0

# TLE Data Source
CELESTRAK_API_URL=https://celestrak.org/NORAD/elements/gp.php
TLE_CACHE_HOURS=6

# SATCAT Data
SATCAT_API_URL=https://celestrak.org/pub/satcat.csv

# Space Weather (optional)
NOAA_SWPC_URL=https://services.swpc.noaa.gov/json/

# ML Model Configuration
COLLISION_RISK_THRESHOLD_LOW=0.15
COLLISION_RISK_THRESHOLD_MEDIUM=0.30
ALTITUDE_BIN_SIZE_KM=50

# Performance Tuning
DEFAULT_OBJECT_COUNT=10000
MOBILE_OBJECT_COUNT=5000
MAX_OBJECT_COUNT=35000

# Caching
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=21600

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Databricks Deployment (optional)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-token-here

# Optional: External APIs
# SPACE_TRACK_USERNAME=your_username
# SPACE_TRACK_PASSWORD=your_password
# LEOLABS_API_KEY=your_api_key
